# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invoice_taggify?schema=public"

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=invoice-taggify-screenshots
R2_PUBLIC_BASE_URL=

# Apify
APIFY_TOKEN=
APIFY_IG_ACTOR_ID=apify~instagram-scraper
APIFY_REEL_ACTOR_ID=data-slayer/instagram-post-details

# Cron
ENABLE_CRON=true
INSTAGRAM_RESCRAPE_CRON=0 */6 * * *
INVOICE_AGING_SWEEP_CRON=0 9 * * *
