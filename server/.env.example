# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invoice_taggify?schema=public"

# Auth
JWT_ACCESS_SECRET=432hjdksfkljadsnfdksj
JWT_REFRESH_SECRET=fdsfdsjfklsdnfiui443249
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Email 2FA (21 Sep) — login OTPs + email verification codes go out through
# Resend (resend.com → API Keys). EMAIL_FROM must be on a domain verified in
# Resend — taggify.in is (tasks.md 23 Sep #2), so the sender is
# noreply@taggify.in. Resend's onboarding@resend.dev only delivers to the
# Resend account owner's own inbox, fine for a first test, useless for real
# users. With RESEND_API_KEY unset: dev prints each code to the server
# console instead of emailing it; production answers 503 (EMAIL_NOT_CONFIGURED).
RESEND_API_KEY=
EMAIL_FROM="Taggify <noreply@taggify.in>"

# Accounts that skip the emailed login code entirely — comma-separated, matched
# on the exact address (28 Sep). Only for the dummy planner/creator accounts
# scripts/seed-test-accounts.js creates: their @taggify.test addresses have no
# inbox, so no code could reach them. The password check still applies; this
# only drops the second factor. Unset (the default) means nobody bypasses —
# leave it unset anywhere real accounts sign in.
OTP_BYPASS_EMAILS=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Apify
APIFY_TOKEN=
APIFY_IG_ACTOR_ID=apify~instagram-scraper
APIFY_REEL_ACTOR_ID=data-slayer/instagram-post-details

# Cron
ENABLE_CRON=true
INSTAGRAM_RESCRAPE_CRON=0 */6 * * *
ASSET_PROFILE_RESCRAPE_CRON=0 3 * * *
INVOICE_AGING_SWEEP_CRON=0 9 * * *
SCREENSHOT_REMINDER_CRON=0 10 * * *
FINANCE_EXPORT_CRON=0 2 * * *
FINANCE_GOOGLE_SHEET_EXPORT_CRON=0 2 * * *

# Daily finance export → GitHub (newTask.md #2). GITHUB_TOKEN needs a fine-
# grained PAT scoped to just this repo with Contents: Read and write — until
# these three are set, the finance_export job runs on schedule but fails
# with a clear message in JobRun (visible on /job-runs), it doesn't crash
# anything else. Pushes to GITHUB_FINANCE_BRANCH (created automatically if
# it doesn't exist yet), not `main` — see financeExport.js for why.
GITHUB_TOKEN=
GITHUB_REPO_OWNER=deepak007-star
GITHUB_REPO_NAME=taggify-invoice
GITHUB_FINANCE_BRANCH=finance-data
GITHUB_FINANCE_PATH=finance-exports/finance-data.xlsx

# Daily finance export → a live Google Sheet (newTask.md, 8 Sep), alongside
# the GitHub export above, not instead of it. Needs a Google Cloud service
# account with the Sheets API enabled — see the project's setup notes for
# the exact console steps. GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY is the key
# file's `private_key` field pasted as one line with real newlines replaced
# by `\n` (most hosts, incl. Render, require this — the app un-escapes it
# back to a real PEM at read time). GOOGLE_FINANCE_SPREADSHEET_ID is the
# long id in the sheet's own URL
# (docs.google.com/spreadsheets/d/<THIS PART>/edit) — that sheet must be
# shared with GOOGLE_SERVICE_ACCOUNT_EMAIL as an Editor, the same as sharing
# it with a person. Until all three are set, finance_google_sheet_export
# runs on schedule but fails with a clear message in JobRun, same as
# finance_export above when GITHUB_TOKEN is missing.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_FINANCE_SPREADSHEET_ID=

# Plan Google Sheets (user request, 10 Sep — "plan will be of google sheet,
# not in pdf ... generate google sheet and will provide link"; later, "1
# spreadsheet generation per plan, not just write access, and also public
# view access of sheet to anyone"). A plain service account has no Drive
# storage quota of its own to create new files in (verified: 403 on
# spreadsheets.create), so this does NOT reuse GOOGLE_SERVICE_ACCOUNT_*
# above — it's a separate OAuth *user* flow instead, so each plan's sheet
# is created under a real Google account's own Drive.
#
# One-time setup (see console.cloud.google.com, same project as the
# service account above): APIs & Services → OAuth consent screen (External,
# add yourself as a test user) → Credentials → Create Credentials → OAuth
# client ID → Web application → Authorized redirect URI
# `<your server origin>/api/integrations/google/callback`. Then, once these
# three are set and the server is running, an ADMIN visits
# `<server origin>/api/integrations/google/authorize` once in a browser to
# grant access — the resulting refresh token is stored in the AppSetting
# table, not here, so this step only needs doing once per environment.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
