generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CREATOR
  TEAM_MEMBER
  ADMIN
  FINANCE
  // Phase 4 (newTask.md, 8 Sep) — "Planner (POC)": makes/approves their own
  // Plans and reads Inventory, but can't create Campaigns, review Links, or
  // manage Users/Finance. See lib/permissions.js for the exact split.
  PLAN_MAKER
}

// Plan approval workflow (newTask.md, 8 Sep: "Plan Maker... approves plans
// he created as well" / "Admin... even approving plans"). New plans start
// DRAFT (still being assembled); a Plan Maker submits one for approval, then
// either they themselves or an Admin approves/rejects it — see
// plans/service.js's submitPlan/approvePlan/rejectPlan for who can do which.
enum PlanStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum LinkStatus {
  SUBMITTED
  PENDING_SCREENSHOT_REVIEW
  SCREENSHOT_REJECTED
  SCREENSHOT_APPROVED
  INSIGHTS_PENDING
  INSIGHTS_APPROVED
  INVOICED
  // Admin-confirmed dead/broken post (newTask.md, 8 Sep — "posted link not
  // working"). Terminal, like INVOICED: a soft flag, not a delete, so the
  // record and its LinkStatusEvent history stay for audit — it's just
  // excluded from campaign spend and every "needs action"/"uninvoiced" KPI.
  // Can't be reached from INVOICED (see markLinkInvalid in links/service.js).
  INVALID
}

enum InvoiceStatus {
  DRAFT
  RAISED
  APPROVED
  REJECTED
  PAID
}

enum GstStatus {
  PENDING
  SCHEDULED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// Admin/Finance-initiated payout to a creator/vendor (tasks.md, 23 Sep —
// "Payments" tab, internal costing side) — distinct from Invoice, which is
// the creator's own self-raised bill (13 Sep decision: "only the creator
// raises their own invoice"). A Payout is a push, not a pull: Finance picks
// the links and pays; it never goes through RAISED/APPROVED vetting. DRAFT
// means the links are locked (via PayoutItem) but no receipt has been
// attached yet; PAID is set the moment the receipt upload is confirmed.
enum PayoutStatus {
  DRAFT
  PAID
  CANCELLED
}

model User {
  id                   String    @id @default(cuid())
  // Optional since 24 Sep — accounts are created with an email (the login
  // identifier); a phone is extra contact info when the admin has one.
  phoneNumber          String?   @unique
  passwordHash         String
  role                 Role
  name                 String?
  email                String?   @unique
  // Email 2FA (21 Sep). `email` above doubles as the login identifier, but
  // only once emailVerifiedAt is set — until then it's just an unverified
  // profile field and the account still signs in by phone number.
  // unverifiedLoginCount is how many phone+password logins this account has
  // used without a verified email; past MAX_UNVERIFIED_LOGINS (auth/service.js)
  // login stops issuing a session and forces the verify-email step instead.
  emailVerifiedAt      DateTime?
  unverifiedLoginCount Int       @default(0)
  secondaryPhone       String?
  addressLine1         String?
  addressLine2         String?
  state                String?
  pincode              String?
  whatsappVerified     Boolean   @default(false)
  // Sub-admin permission overlay (newTask.md, 8 Sep — "Admin can create
  // Sub-admins, each with a hand-picked selection of what they can
  // see/access"). Null = plain account, full role-default access. Set only
  // on an ADMIN-role account to restrict it below the default ADMIN grant —
  // an ADMIN row with this set is what "Sub-admin" *is*, not a separate
  // Role value (the less-invasive of the two migrations the note flagged;
  // see lib/permissions.js for key names/defaults and getEffectivePermissions()
  // for how an override merges with role defaults).
  permissions          Json?
  // Which admin created this account, when it's a sub-admin — the audit
  // trail newTask.md's "suggested improvements" asked for (who gave X
  // visibility into Y). Null for every account not created via the
  // sub-admin flow (including the very first admin).
  createdByAdminId     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  createdByAdmin            User?                   @relation("AdminCreatedSubAdmins", fields: [createdByAdminId], references: [id])
  createdSubAdmins          User[]                  @relation("AdminCreatedSubAdmins")
  memberships               TeamMembership[]        @relation("MemberUser")
  refreshTokens             RefreshToken[]
  trustedDevices            TrustedDevice[]
  emailOtps                 EmailOtp[]
  assets                    Asset[]
  invoices                  Invoice[]
  raisedInvoices            Invoice[]               @relation("RaisedInvoices")
  notifications             Notification[]
  submittedLinks            Link[]                  @relation("SubmittedByUser")
  statusEvents              LinkStatusEvent[]
  billingProfiles           BillingProfile[]
  costRevisions             LinkCostRevision[]
  plans                     Plan[]
  approvedPlans             Plan[]                  @relation("PlanApprovals")
  issuedClientInvoices      ClientInvoice[]         @relation("IssuedClientInvoices")
  permissionChangesMade     PermissionAuditLog[]    @relation("PermissionChangeActor")
  permissionChangesReceived PermissionAuditLog[]    @relation("PermissionChangeTarget")
  payouts                   Payout[]                @relation("PayoutCreator")
  createdPayouts            Payout[]                @relation("PayoutCreatedBy")
  bulkTrackedProfiles       BulkTrackedProfile[]
  bulkTrackedPosts          BulkTrackedPost[]
  bulkImportBatches         BulkImportBatch[]
  bulkImportSheetSources    BulkImportSheetSource[]
  markedPaidPayouts         Payout[]                @relation("PayoutMarkedPaidBy")
}

// Audit trail for sub-admin permission grants/edits (newTask.md, 8 Sep
// "suggested improvements" — "log who changed whose access and when").
// Written on every sub-admin creation and every permission edit; never
// updated or deleted, so it stays a true history even if permissions are
// changed again later.
model PermissionAuditLog {
  id        String   @id @default(cuid())
  targetId  String
  actorId   String
  // What changed (23 Sep): "permissions" (overlay edit / sub-admin creation),
  // "role" (before/after = {role, permissions}), or "password_reset" (a
  // takeover primitive — whoever reads the new password off the response is
  // that user until they change it, so it's logged like an access change).
  action    String   @default("permissions")
  before    Json?
  after     Json
  createdAt DateTime @default(now())

  target User @relation("PermissionChangeTarget", fields: [targetId], references: [id])
  actor  User @relation("PermissionChangeActor", fields: [actorId], references: [id])

  @@index([targetId])
}

// Payout/tax identity a creator registers to receive invoice payments —
// separate from Invoice itself since one user can hold several (e.g. one
// per PAN/entity), and it needs its own admin approval gate.
model BillingProfile {
  id                String   @id @default(cuid())
  userId            String
  pan               String   @unique
  name              String // name on the PAN
  gstin             String?
  msme              String?
  bankAccountNumber String
  ifscCode          String
  approvalStatus    String   @default("pending") // pending | approved | rejected
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TeamMembership {
  id          String   @id @default(cuid())
  userId      String // the team member (User.role = TEAM_MEMBER)
  creatorId   String // the owning creator's User.id
  canSeeMoney Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, creatorId])
}

enum EmailOtpPurpose {
  LOGIN
  VERIFY_EMAIL
}

// One emailed 6-digit code (email 2FA, 21 Sep). Only a hash of the code is
// stored. `email` is the address it was sent to — for VERIFY_EMAIL that's
// the not-yet-verified address being claimed, which only lands on User.email
// once the code is confirmed.
model EmailOtp {
  id         String          @id @default(cuid())
  userId     String
  purpose    EmailOtpPurpose
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int             @default(0)
  consumedAt DateTime?
  createdAt  DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// "Skip OTP for 7 days" (user decision, 23 Sep) — one row per browser that
// has completed a real email-OTP verification. auth/service.js's login()
// checks this before issuing a new OTP for a verified account; only its
// hash is ever stored (same discipline as RefreshToken/EmailOtp), the raw
// token lives solely in an httpOnly cookie the browser sends back. Password
// is still checked in every branch before this is ever consulted — this
// only ever shortens the *second* factor, never replaces the first.
model TrustedDevice {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Asset {
  id                  String    @id @default(cuid())
  ownerId             String
  platform            String    @default("instagram")
  handle              String
  followers           Int       @default(0)
  fullName            String? // profile display name, synced from Apify
  biography           String? // profile bio, synced from Apify
  profilePicUrl       String? // Instagram CDN URL, synced from Apify — re-synced every 24h so it doesn't go stale
  // Our own copy of that picture in Cloudinary (22 Sep), re-uploaded after
  // every scrape — served first by GET /assets/:id/profile-pic, since
  // Instagram's CDN links expire and flake. See assets/service.js storeProfilePic.
  profilePicStoredUrl String?
  category            String? // free-form, e.g. "Meme page", "News page" — not a fixed enum, same convention as RateCard.format
  approvalStatus      String    @default("pending") // pending | approved | rejected
  // Admin switch (8 Oct): an inactive page can't be added to new plans; everything else stays the same.
  isActive            Boolean   @default(true)
  // Profile-level engagement from the same Apify profile scrape that syncs
  // followers (Inventory "Create page", 14 Sep — "on creation automatic
  // fetching of followers count, avg views"): averaged over the profile's
  // latest posts, so a page with no links submitted through the app yet
  // still shows real numbers. getAvgEngagement() prefers the app's own
  // per-link snapshots once there are any.
  profileAvgViews     Int?
  profileAvgLikes     Int?
  profileAvgComments  Int?
  profileSampleSize   Int       @default(0)
  // Manually entered engagement (Inventory's Edit panel, 28 Sep). Each
  // non-null figure replaces that one number in getAvgEngagement's automatic
  // result and survives every re-scrape — unlike profileAvg* above, which the
  // next profile scrape overwrites. Null = that figure stays automatic, so
  // clearing the box hands the number back to the scrape.
  manualAvgViews      Int?
  manualAvgLikes      Int?
  manualAvgComments   Int?
  // When the last profile scrape succeeded / why the last one failed — lets
  // the Inventory row say "Fetching from Instagram…" right after creation,
  // or "Couldn't fetch (private / bad handle)" instead of a silent 0.
  lastScrapedAt       DateTime?
  lastScrapeError     String?
  // Set the moment a profile scrape is queued (create / import / bulk
  // refresh), cleared when it finishes either way — the Inventory row's
  // "Fetching from Instagram…" state, without guessing from createdAt.
  scrapeQueuedAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  owner       User                 @relation(fields: [ownerId], references: [id])
  rateCards   RateCard[]
  links       Link[]
  snapshots   AccountSnapshot[]
  assignments CampaignAssignment[]
  planItems   PlanItem[]

  @@unique([ownerId, platform, handle])
}

// One row per page/creator an admin listed when attaching a sheet to a
// campaign (newTask.md #8) — "which pages/creators is this campaign visible
// to". `pageHandle`/`creatorPhone` are the raw values from that sheet, kept
// even after matching for reference. `assetId` is filled in once matched to
// an existing page, or once an admin creates the missing page for a
// still-pending row (newTask.md #11's approval-before-creation gate is the
// existing Asset.approvalStatus flow on whatever gets created here — since
// 14 Sep a page an ADMIN creates is approved on the spot; only a creator's
// own additions start "pending").
//
// `postUrl`/`format`/`cost` (newTask.md, 8 Sep — "if a post link is already
// mentioned in the attached sheet, it should get added directly to that
// creator's posts") are optional columns the same sheet can carry alongside
// handle/phone. Kept even after auto-attaching, same as pageHandle/
// creatorPhone, so the row still shows what the sheet actually said.
// `linkId` is set once that attach has happened — either at campaign
// creation (row already matched an existing page) or later, when an admin
// resolves a still-pending row (see campaigns/service.js's
// autoAttachLinkIfPossible) — and is what makes the attach idempotent: a
// row is only ever auto-attached once, however many times its assignment
// gets touched afterward.
model CampaignAssignment {
  id           String   @id @default(cuid())
  campaignId   String
  assetId      String?
  pageHandle   String
  creatorPhone String?
  postUrl      String?
  format       String?
  cost         Decimal? @db.Decimal(12, 2)
  linkId       String?  @unique
  status       String   @default("pending") // pending | matched
  createdAt    DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  asset    Asset?   @relation(fields: [assetId], references: [id])
  link     Link?    @relation(fields: [linkId], references: [id])

  @@index([campaignId])
}

model RateCard {
  id            String   @id @default(cuid())
  assetId       String
  format        String // reel | story | carousel | collaboration | video
  amount        Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, format])
}

// A campaign can grow phases (newTask.md, 8 Sep — "campaign can have
// multiple phase if need to add 2 post for same campaign"): more posts
// added to the same brand deal later, rather than a brand-new campaign.
// parentCampaignId is null for a standalone campaign or a phase 1; a phase
// 2+ points back at phase 1's row. Budget/spend roll up across every phase
// under one parent (see campaigns/service.js's annotateCampaign) — a phase
// isn't a separate budget, it's more work under the same one.
model Campaign {
  id               String    @id @default(cuid())
  brandName        String
  title            String
  deadline         DateTime?
  costCap          Decimal?  @db.Decimal(12, 2) // total budget cap (newTask.md #8) — "remaining budget" (#9) is derived: costCap - sum(links.cost), not stored
  sheetLink        String? // reference URL (e.g. a Google Sheet) an admin attached when creating the campaign — kept as a plain link, not live-fetched; the actual page/creator list comes in via an uploaded file (see CampaignAssignment)
  parentCampaignId String?
  phaseNumber      Int       @default(1)
  // Two kinds of child row (22 Sep): a real phase (postNumber 1, shown as a
  // phase to everyone) and an extra post of a phase (postNumber 2+, same
  // phaseNumber as the phase it belongs to — a page booked for 2 reels).
  // Admins see an extra post as one more post of that phase; creators see
  // every row as its own numbered phase (see lib/campaignPhases.js).
  postNumber       Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  parentCampaign Campaign?            @relation("CampaignPhases", fields: [parentCampaignId], references: [id])
  phases         Campaign[]           @relation("CampaignPhases")
  links          Link[]
  assignments    CampaignAssignment[]
  invoices       Invoice[]
  Plan           Plan?

  @@index([parentCampaignId])
}

model Link {
  id            String     @id @default(cuid())
  campaignId    String
  assetId       String
  submittedById String
  url           String
  format        String // reel | story | carousel | collaboration | video — mirrors RateCard.format
  cost          Decimal    @db.Decimal(12, 2)
  customRate    Boolean    @default(false)
  status        LinkStatus @default(SUBMITTED)
  postedAt      DateTime?
  // A post beyond what its campaign phase booked for this page (29 Sep —
  // "it's creator's fault, not admin/finance"): the first N by posted date
  // count, where N is the page's assignment slots in the phase, and the rest
  // are over quota — never invoiced, paid, or counted toward spend. Derived,
  // not entered: lib/postQuota.js recomputes it whenever links, bookings or
  // posted dates change, and re-checks it before any money is committed.
  overQuota     Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  campaign           Campaign            @relation(fields: [campaignId], references: [id])
  asset              Asset               @relation(fields: [assetId], references: [id])
  submittedBy        User                @relation("SubmittedByUser", fields: [submittedById], references: [id])
  screenshot         Screenshot?
  postSnapshots      PostSnapshot[]
  invoiceItem        InvoiceItem?
  payoutItem         PayoutItem?
  statusEvents       LinkStatusEvent[]
  costRevisions      LinkCostRevision[]
  // Back-reference for CampaignAssignment.linkId — set only when this Link
  // was auto-attached from a sheet row rather than submitted normally.
  campaignAssignment CampaignAssignment?

  // A page can only ever have one Link for a given post URL (23 Sep — the
  // actual guard behind links/service.js's autoAttachLink duplicate check,
  // which was previously a read-then-write race: two overlapping calls,
  // e.g. a double-clicked "Refresh links" on a plan's execution sheet,
  // could both pass a plain findFirst before either insert landed and
  // create two billable Links for one post). No existing rows violated
  // this at the time it was added (checked before the migration).
  @@unique([url, assetId])
  @@index([status])
  @@index([assetId])
  @@index([campaignId])
}

// Audit trail for admin-revised per-page costs within a campaign (newTask.md
// #10) — Link.cost itself always holds the current value; this is the
// history of what it used to be and why.
model LinkCostRevision {
  id           String   @id @default(cuid())
  linkId       String
  previousCost Decimal  @db.Decimal(12, 2)
  newCost      Decimal  @db.Decimal(12, 2)
  note         String?
  revisedById  String
  createdAt    DateTime @default(now())

  link      Link @relation(fields: [linkId], references: [id], onDelete: Cascade)
  revisedBy User @relation(fields: [revisedById], references: [id])

  @@index([linkId])
}

model LinkStatusEvent {
  id        String     @id @default(cuid())
  linkId    String
  status    LinkStatus
  actedById String?
  note      String?
  createdAt DateTime   @default(now())

  link    Link  @relation(fields: [linkId], references: [id], onDelete: Cascade)
  actedBy User? @relation(fields: [actedById], references: [id])

  @@index([linkId])
}

model Screenshot {
  id           String   @id @default(cuid())
  linkId       String   @unique
  publicId     String // Cloudinary public_id
  reviewedById String?
  approved     Boolean?
  createdAt    DateTime @default(now())

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)
}

model PostSnapshot {
  id             String   @id @default(cuid())
  linkId         String
  likeCount      Int
  commentsCount  Int
  videoViews     Int
  videoPlayCount Int
  saves          Int
  shares         Int
  reposts        Int
  thumbnailUrl   String? // post's display image/cover, from Apify — powers the campaign card's post preview
  caption        String? // post caption text, from Apify — same card
  source         String   @default("apify")
  capturedAt     DateTime @default(now())

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
}

model AccountSnapshot {
  id         String   @id @default(cuid())
  assetId    String
  followers  Int
  mediaCount Int
  source     String   @default("apify")
  capturedAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
}

model Invoice {
  id                     String        @id @default(cuid())
  creatorId              String
  invoiceNumber          String        @unique
  amount                 Decimal       @db.Decimal(12, 2) // final billed total = subtotal + gstAmount
  subtotal               Decimal       @db.Decimal(12, 2) // sum of the invoiced links' cost, pre-GST
  isGstInvoice           Boolean       @default(false)
  gstAmount              Decimal       @default(0) @db.Decimal(12, 2) // 18% of subtotal when isGstInvoice, else 0
  status                 InvoiceStatus @default(DRAFT)
  paymentStatus          PaymentStatus @default(PENDING)
  gstStatus              GstStatus     @default(PENDING)
  remarks                String? // e.g. rejection reason
  dueDate                DateTime?
  paidAt                 DateTime?
  // campaignId is what the campaign page lists "its" invoices by and what
  // scopes a Plan Maker's invoice visibility; it is set when every link on
  // the invoice belongs to one campaign. raisedById records who generated
  // it (null for older rows). Since 13 Sep only the creator raises their
  // own invoices — the 12 Sep "generate from the campaign page" path (Admin
  // / Plan Maker) was removed; the columns stay for the rows it produced.
  campaignId             String?
  raisedById             String?
  // 12 Sep — the creator's own invoice document (their GST invoice PDF/
  // image) attached to this record, so Finance has it next to the
  // system-generated one. Cloudinary public_id, like Screenshot; the
  // original file name is kept for display since public_ids carry none.
  attachmentPublicId     String?
  attachmentName         String?
  attachmentUploadedById String?
  attachmentUploadedAt   DateTime?
  // Finance backfilling proof of payment onto an invoice paid without ever
  // going through a Payout (legacy direct-mark-paid rows, and the guard in
  // invoices/service.js keeps this from being used once a real Payout receipt
  // exists for the invoice's links) — same shape as Payout's own receipt.
  receiptPublicId        String?
  receiptName            String?
  receiptUploadedById    String?
  receiptUploadedAt      DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  creator  User          @relation(fields: [creatorId], references: [id])
  campaign Campaign?     @relation(fields: [campaignId], references: [id])
  raisedBy User?         @relation("RaisedInvoices", fields: [raisedById], references: [id])
  items    InvoiceItem[]

  @@index([creatorId])
  @@index([campaignId])
  @@index([status])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  linkId    String  @unique
  amount    Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  link    Link    @relation(fields: [linkId], references: [id])
}

model Payout {
  id                String       @id @default(cuid())
  creatorId         String // payee — Asset.ownerId of every link on it, the "vendor"
  subtotal          Decimal      @db.Decimal(12, 2)
  isGstInvoice      Boolean      @default(false)
  gstAmount         Decimal      @default(0) @db.Decimal(12, 2) // 18% of subtotal when isGstInvoice, else 0
  tdsPercent        Decimal?     @db.Decimal(5, 2) // 1 | 2 | 10, null = no TDS withheld
  tdsAmount         Decimal      @default(0) @db.Decimal(12, 2)
  netAmount         Decimal      @db.Decimal(12, 2) // subtotal + gstAmount - tdsAmount, what actually gets paid
  status            PayoutStatus @default(DRAFT)
  createdById       String
  paidAt            DateTime?
  markedPaidById    String?
  receiptPublicId   String?
  receiptName       String?
  receiptUploadedAt DateTime?
  // Bank transfer reference Finance types in when marking paid (24 Sep
  // Payments redesign) — optional, shown to the creator beside the receipt.
  utr               String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  creator      User         @relation("PayoutCreator", fields: [creatorId], references: [id])
  createdBy    User         @relation("PayoutCreatedBy", fields: [createdById], references: [id])
  markedPaidBy User?        @relation("PayoutMarkedPaidBy", fields: [markedPaidById], references: [id])
  items        PayoutItem[]

  @@index([creatorId])
  @@index([status])
}

model PayoutItem {
  id       String  @id @default(cuid())
  payoutId String
  linkId   String  @unique // one payout per link, mirrors InvoiceItem — the lock that keeps a link from being paid out twice or paid out and creator-invoiced both
  amount   Decimal @db.Decimal(12, 2)

  payout Payout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  link   Link   @relation(fields: [linkId], references: [id])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// Small generic key/value store for state that isn't tied to any one
// row — currently just the Google OAuth refresh token (see
// googleOAuthClient.js: per-plan spreadsheet creation needs a real Google
// account's Drive quota, which means user-consent OAuth instead of the
// zero-quota service account) and the reusable execution-sheet template's
// spreadsheet id.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model JobRun {
  id         String    @id @default(cuid())
  jobName    String
  status     String // running | success | failed
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  error      String?

  @@index([jobName, startedAt])
}

// "Inventory" (newTask.md #13) — a proposal an admin builds to pitch a set
// of pages to a brand client, exported as a PDF. Distinct from Campaign:
// a Campaign is work actually happening; a Plan is a pitch that may never
// become one. cost/expected engagement are computed at read time from the
// selected pages (service.js), not stored, same as Campaign's budget fields.
model Plan {
  id              String     @id @default(cuid())
  name            String
  clientName      String
  clientContact   String?
  // Client-details block (user request, 10 Sep — "client details to be
  // filled option ... company name, gst number, address etc").
  clientCompany   String?
  clientGstNumber String?
  clientAddress   String?
  // Free-form brief/note from the wizard's Basics step, rendered as an
  // extra NOTES bullet on the PDF alongside the two fixed ones.
  notes           String?
  budget          Decimal?   @db.Decimal(12, 2)
  // Client-facing GST % on this plan's invoice/overview (user request, 17
  // Sep — replaces the old fixed-18%-or-nothing isGstPlan toggle, which
  // could only ever add exactly 18% or nothing). Null/0 = no GST line.
  gstPercent      Decimal?   @db.Decimal(5, 2)
  status          PlanStatus @default(DRAFT)
  approvedById    String?
  approvedAt      DateTime?
  createdById     String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Plan B/C/etc (user request, 10 Sep — "option of making plan b or other
  // plan"): a plain shared tag, not a FK to a group table — two Plan rows
  // with the same pitchGroupId started from one shared client-details/
  // budget shell (see plans/service.js's createPlanVariant) and are fully
  // independent after that, deliberately not kept in sync. No relation
  // annotation needed since nothing but this id is shared.
  pitchGroupId String?
  variantLabel String  @default("Plan A")
  // The plan sheet's layout (8 Oct): "breakdown" (a row per page category)
  // or "summary" (one campaign-overview block). Chosen per plan.
  sheetFormat  String  @default("breakdown")

  // Step 3's editable client-facing overview numbers (user request, 10 Sep
  // — "client side facing overview, budget total cost, impressions that
  // can be editable"). Null = keep showing the computed value, same as
  // every plan before this column existed — see plans/service.js's
  // annotatePlan.
  overrideFollowers   Int?
  overridePosts       Int?
  overrideImpressions Int?
  overrideCost        Decimal? @db.Decimal(12, 2)

  // The generated deliverables (user request, 10 Sep — "plan will be of
  // google sheet, not in pdf, it'll generate google sheet and will provide
  // link" / "list of plans ... option of viewing googlesheet of plan for
  // client or internal"). Cached here so revisiting Build (or the Plans
  // list) doesn't spin up a fresh spreadsheet tab pair every time;
  // "Regenerate" overwrites in place (see plans/service.js's
  // generatePlanSheet).
  clientSheetUrl          String?
  internalSheetUrl        String?
  // The execution sheet (user request, 10 Sep — "execution sheet will be
  // page name, links of their reel uploaded, date, page followers etc").
  // Whoever's actually posting fills this sheet in themselves, using the
  // shape the sample template (see plans/service.js's
  // getExecutionSheetTemplate) shows them. Since 23 Sep (user decision:
  // "parse → auto-create links") it is read, not just stored: on attach and
  // on Refresh, every row naming a Posted Link becomes a SUBMITTED Link for
  // that page's owner on the plan's campaign (see plans/service.js's
  // syncExecutionSheet), so the creator's invoice is one click away. Rows
  // that couldn't become links — page not in the plan, no post link, more
  // posts than the plan booked — sit in executionSheetPending as
  // [{ rowNumber, pageHandle, postUrl, reason }] for the card to list.
  executionSheetUrl       String?
  executionSheetFetchedAt DateTime?
  executionSheetPending   Json?
  // "Upload plan" (user request, 22 Sep — "plan maker can upload their own
  // made excel sheet plan ... anything missing ... will be shown as missing
  // ... refresh button of fetching updated sheet"): a plan built FROM a
  // pasted Google Sheet rather than the wizard. The link is kept so Refresh
  // re-fetches the same sheet (the user never re-attaches it); pending holds
  // the sheet rows that couldn't become items yet — a handle not in
  // Inventory, a page with no cost, a budget the pages exceed — as
  // [{ kind: "page" | "budget", handle?, ..., reason }]. See plans/service.js's
  // applySheetToPlan.
  sourceSheetUrl          String?
  sourceSheetFetchedAt    DateTime?
  sourceSheetPending      Json?

  // Client invoice (user request, 13 Sep — "on clicking generate invoice,
  // it'll ask for client details like gst, company address, phone number"):
  // the Taggify → client invoice for this plan's client-facing total. The
  // details are asked for in a popup and saved back here (clientPhone is
  // new; company/GST/address reuse the columns above), the number is
  // minted once and kept across regenerations so the client never sees
  // two numbers for one plan. See plans/service.js's generateClientInvoice.
  clientPhone         String?
  clientInvoiceNumber String?   @unique
  clientInvoiceAt     DateTime?
  // Asked for in the same popup (user request, 17 Sep): the one line of
  // "Description of goods/service" the Proforma Invoice bills, and the
  // HSN/SAC code printed against it (blank = the company default).
  invoiceDescription  String?
  hsnSac              String?

  // Attached invoice document (user request, 14 Sep — "in plans for
  // admin, plan maker side, there'll be option of attaching invoice
  // document in pdf format as well"): a PDF the Admin / Plan Maker uploads
  // and keeps on the plan next to the generated client invoice — e.g. the
  // signed copy, or one raised outside the system. Same Cloudinary
  // public_id + original-name layout as Invoice.attachment*.
  invoiceAttachmentPublicId     String?
  invoiceAttachmentName         String?
  invoiceAttachmentUploadedById String?
  invoiceAttachmentUploadedAt   DateTime?

  // Set once, on approval (user request, 10 Sep — "on his marking all pages
  // mentioned in the plan will get the campaign visible"): a real Campaign
  // is created from the plan's pages, one CampaignAssignment per distinct
  // page, already "matched" so each page's owner sees it immediately in
  // their own dashboard — same visibility path every other campaign
  // already uses, not a parallel one. Only ever set once; a plan is
  // APPROVED exactly one time (see plans/service.js's decidePlan).
  campaignId String? @unique

  createdBy     User           @relation(fields: [createdById], references: [id])
  approvedBy    User?          @relation("PlanApprovals", fields: [approvedById], references: [id])
  campaign      Campaign?      @relation(fields: [campaignId], references: [id])
  items         PlanItem[]
  // The receivables ledger row for this plan's client invoice (23 Sep) —
  // see ClientInvoice below.
  clientInvoice ClientInvoice?

  @@index([pitchGroupId])
}

enum ClientInvoiceStatus {
  ISSUED
  PAID
  CANCELLED
}

// Receivables ledger (user decision, 23 Sep — "track + list in /invoices"):
// one row per plan whose client invoice has been generated. The document
// itself (number, GST, address, HSN…) still lives on the Plan columns above
// and the PDF is still rendered from the plan on demand; this row is what
// Finance sees and settles in the Receivables view of /invoices, without
// needing plan access. Upserted by plans/service.js's generateClientInvoice
// (a regenerate refreshes the totals, never the status/number), settled by
// invoices/clientInvoices.js. Mirrors the payables side (Invoice) at the
// coarse ISSUED → PAID / CANCELLED level — a client invoice is issued by us,
// so there is no RAISED/APPROVED vetting stage.
model ClientInvoice {
  id            String              @id @default(cuid())
  planId        String              @unique
  // Copied from Plan.campaignId at issue time so the campaign/plan-maker
  // views can join receivable ↔ payables without going through the plan.
  campaignId    String?
  invoiceNumber String              @unique
  subtotal      Decimal             @db.Decimal(12, 2)
  gstPercent    Decimal?            @db.Decimal(5, 2)
  gstAmount     Decimal             @default(0) @db.Decimal(12, 2)
  total         Decimal             @db.Decimal(12, 2)
  status        ClientInvoiceStatus @default(ISSUED)
  issuedAt      DateTime            @default(now())
  issuedById    String?
  paidAt        DateTime?
  paidAmount    Decimal?            @db.Decimal(12, 2)
  remarks       String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  plan     Plan  @relation(fields: [planId], references: [id])
  issuedBy User? @relation("IssuedClientInvoices", fields: [issuedById], references: [id])

  @@index([status])
  @@index([campaignId])
}

model PlanItem {
  id              String   @id @default(cuid())
  planId          String
  assetId         String
  format          String // reel | story | carousel | collaboration | video — mirrors RateCard.format
  cost            Decimal  @db.Decimal(12, 2) // internal — snapshot of the rate at the time it was added to the plan
  // Client-facing price for this line, when it differs from the internal
  // cost above (markup/margin) — newTask.md, 8 Sep. Null = show the
  // internal cost as-is. NEVER read directly by anything client-facing
  // (PDF) without going through plans/service.js's forClientPdf(), which
  // resolves this fallback once in one place rather than leaving every
  // call site to remember `clientCost ?? cost` itself.
  clientCost      Decimal? @db.Decimal(12, 2)
  // How many posts on this one page this line covers — newTask.md, 8 Sep
  // (the example sheet's "Post Per Profile" column). Cost above is
  // per-post; totals multiply by this.
  postsPerProfile Int      @default(1)

  plan  Plan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id])

  @@index([planId])
}

// ─── Bulk Tracker (12 Oct) ───────────────────────────────────────────────────
// Market-research Instagram scraping, ported from wizwebitsolutions/
// affiliate-creator-tool: arbitrary profile/post links (pasted, or imported
// from a Google Sheet) are scraped via Apify. Deliberately NOT tied to Asset,
// Link, Campaign or any payout — it's research data outside managed pages.
// Gated by the opt-in `bulkTrack.view` key (lib/permissions.js OPT_IN_KEYS).

model BulkImportSheetSource {
  id              String    @id @default(cuid())
  addedByUserId   String
  name            String? // optional user-given label, shown instead of the raw URL wherever possible
  sheetUrl        String
  gid             String    @default("0")
  profileLinkCol  String? // detected/confirmed column header for profile links
  postLinkCol     String? // detected/confirmed column header for post links
  categoryCol     String? // detected/confirmed column header for category
  followersCol    String? // detected/confirmed column header for follower count (sheet-sourced — Apify's own follower field is unreliable)
  dateCol         String? // detected/confirmed column header for the post's date
  pageNameCol     String? // detected/confirmed column header for page name — preferred over Apify's scraped name when present
  fetchFollowers  Boolean   @default(true) // scrape each row's profile (followers) via Apify — off = sheet's Followers cell only
  fetchEngagement Boolean   @default(true) // scrape each row's post (views/likes/...) via Apify — off = post rows kept as "not_fetched"
  lastCheckedAt   DateTime?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())

  addedBy  User                 @relation(fields: [addedByUserId], references: [id])
  batches  BulkImportBatch[]
  profiles BulkTrackedProfile[]
  posts    BulkTrackedPost[]
}

model BulkImportBatch {
  id              String   @id @default(cuid())
  createdByUserId String
  sourceType      String // manual | sheet
  sheetSourceId   String?
  status          String   @default("running") // running | done
  totalCount      Int      @default(0)
  successCount    Int      @default(0)
  failedCount     Int      @default(0)
  createdAt       DateTime @default(now())

  createdBy   User                   @relation(fields: [createdByUserId], references: [id])
  sheetSource BulkImportSheetSource? @relation(fields: [sheetSourceId], references: [id])
  profiles    BulkTrackedProfile[]
  posts       BulkTrackedPost[]
}

model BulkTrackedProfile {
  id             String   @id @default(cuid())
  username       String
  profileUrl     String
  pageName       String? // display name from Apify's profile scrape (fullName) — "current state", not time-series, so it lives here not on the snapshot
  category       String?
  status         String   @default("queued") // queued | done | failed
  failureReason  String?
  addedByUserId  String
  sheetSourceId  String?
  batchId        String?
  createdAt      DateTime @default(now())
  // Which batch this row's in-flight job reports to and how many of its rows
  // it settles (see bulkTrack/worker.js) — persisted so a restart can
  // re-queue the job with the same counter claim. Cleared once it's counted.
  pendingBatchId String?
  pendingWeight  Int      @default(0)

  addedBy     User                         @relation(fields: [addedByUserId], references: [id])
  sheetSource BulkImportSheetSource?       @relation(fields: [sheetSourceId], references: [id])
  batch       BulkImportBatch?             @relation(fields: [batchId], references: [id])
  snapshots   BulkTrackedProfileSnapshot[]
  posts       BulkTrackedPost[]

  @@index([addedByUserId])
  @@index([sheetSourceId])
  @@index([batchId])
}

model BulkTrackedProfileSnapshot {
  id         String   @id @default(cuid())
  profileId  String
  followers  Int      @default(0)
  capturedAt DateTime @default(now())

  profile BulkTrackedProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model BulkTrackedPost {
  id             String   @id @default(cuid())
  permalink      String
  profileId      String? // set when imported alongside its profile (e.g. a sheet row with both columns); null for a standalone pasted post link
  pageLink       String? // raw "Page Link" cell from the sheet row this post came from — not derived/scraped, just copied
  pageName       String? // raw "Page Name" cell from the sheet row, when the sheet has one — preferred over the Apify-scraped name on the post's snapshot
  followers      Int? // raw "Followers" cell from the sheet row, comma-stripped — Apify's follower count came back null on every real post tested, so this is sheet-sourced, not scraped
  postedDate     String? // raw "Posted date" cell from the sheet row, kept as-is (no parsing — formats vary across sheets)
  status         String   @default("queued") // queued | done | failed | broken
  postType       String? // reel | post — set on status=done, based on whether the scrape returned video plays
  failureReason  String?
  addedByUserId  String
  sheetSourceId  String?
  batchId        String?
  createdAt      DateTime @default(now())
  // Which batch this row's in-flight job reports to and how many of its rows
  // it settles (see bulkTrack/worker.js) — persisted so a restart can
  // re-queue the job with the same counter claim. Cleared once it's counted.
  pendingBatchId String?
  pendingWeight  Int      @default(0)

  addedBy     User                      @relation(fields: [addedByUserId], references: [id])
  profile     BulkTrackedProfile?       @relation(fields: [profileId], references: [id])
  sheetSource BulkImportSheetSource?    @relation(fields: [sheetSourceId], references: [id])
  batch       BulkImportBatch?          @relation(fields: [batchId], references: [id])
  snapshots   BulkTrackedPostSnapshot[]

  @@index([addedByUserId])
  @@index([sheetSourceId])
  @@index([batchId])
}

model BulkTrackedPostSnapshot {
  id         String   @id @default(cuid())
  postId     String
  views      Int      @default(0)
  likes      Int      @default(0)
  comments   Int      @default(0)
  shares     Int      @default(0)
  reposts    Int      @default(0)
  saves      Int      @default(0)
  pageName   String? // author's display name, off the same post-scrape call — no separate profile-actor call
  followers  Int? // author's follower count, same call — Apify has returned null for this on every real post tested so far
  capturedAt DateTime @default(now())

  post BulkTrackedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
}
